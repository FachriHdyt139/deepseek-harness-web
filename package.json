{
  "name": "deepseek-harness-web",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness Web AI — web UI for the DeepSeek Harness coding agent on Render Free.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:server": "node --watch server.js",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/harness-init.js",
    "harness:init": "node scripts/harness-init.js",
    "start": "node server.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@lezer/highlight": "1.2.5",
    "@supabase/supabase-js": "2.117.2",
    "adm-zip": "0.6.1",
    "codemirror": "6.0.2",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.1",
    "vite": "8.3.1"
  }
