NODE_ENV=development

PORT=3000

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider consumed by DeepSeek Harness.
# AI_API_KEY is forwarded to the harness as DEEPSEEK_API_KEY when the
# dedicated variable is not set.
DEEPSEEK_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# GitHub OAuth app (optional, feature is disabled without it)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public origin of this deployment, e.g. my-app.onrender.com (no scheme).
# Used as --trusted-host for the harness GUI so browsers can reach it
# through the reverse proxy. Leave empty for local development.
TRUSTED_HOST=

# Limits
MAX_UPLOAD_MB=50
MAX_ACTIVE_SESSIONS=1
SESSION_TIMEOUT_MINUTES=30
MAX_CHAT_REQUESTS_PER_MINUTE=10
MAX_PROMPT_CHARS=20000
MAX_TOOL_OUTPUT_CHARS=20000

# Internal port for the harness web server (loopback only)
HARNESS_PORT=3099
